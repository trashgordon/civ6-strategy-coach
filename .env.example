# --- Model selection (LiteLLM model string) -------------------------------
# Anything LiteLLM supports works. A few examples:
#   anthropic/claude-sonnet-5
#   openai/gpt-5
#   gemini/gemini-2.5-pro
#   ollama/llama3.1            (local, no API key needed)
MODEL=anthropic/claude-sonnet-5

# --- Provider API key -----------------------------------------------------
# Set whichever one matches the MODEL above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Reasoning depth ------------------------------------------------------
# Reasoning models (Claude Sonnet 5 / Opus 5, o-series, Gemini thinking) spend output
# tokens reasoning before writing the plan. "low" keeps that in check — the coach's
# brief is short by design. Raise to "medium"/"high" for more deliberation and cost.
# Ignored by models that don't reason.
# REASONING_EFFORT=low

# --- Grounding in your own game install -----------------------------------
# Optional. `python -m backend.extract_gamedata` reads the real tech/civic/wonder/card
# names out of your Civ VI install so the coach picks from them instead of recalling.
# Both paths are auto-detected; set them only if detection fails.
# CIV6_PATH=~/Library/Application Support/Steam/steamapps/common/Sid Meier's Civilization VI
# FACTS_PATH=./data/facts

# --- Prompt caching -------------------------------------------------------
# On by default when game-data grounding is active: the facts block is identical on
# every call, so it's cached and re-read at a tenth of the price. Worth it when you
# generate more than one plan within the provider's cache window (~5 min); a lone
# cold call pays a small write premium instead. Set to 0 to disable.
# PROMPT_CACHE=1

# --- Storage --------------------------------------------------------------
# SQLite file for your saved builds. Optional; this is the default.
# DB_PATH=./data/strategies.db

# --- Optional password gate ----------------------------------------------
# Leave unset for local-only use (no login screen at all).
# Set it if you expose this instance beyond localhost.
# APP_PASSWORD=

# --- Server ---------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
