# --- Model selection (LiteLLM model string) -------------------------------
# Anything LiteLLM supports works. A few examples:
#   anthropic/claude-sonnet-4-6
#   openai/gpt-5
#   gemini/gemini-2.5-pro
#   ollama/llama3.1            (local, no API key needed)
MODEL=anthropic/claude-sonnet-4-6

# --- Provider API key -----------------------------------------------------
# Set whichever one matches the MODEL above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Storage --------------------------------------------------------------
# SQLite file for your saved builds. Optional; this is the default.
# DB_PATH=./data/strategies.db

# --- Optional password gate ----------------------------------------------
# Leave unset for local-only use (no login screen at all).
# Set it if you expose this instance beyond localhost.
# APP_PASSWORD=

# --- Server ---------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
